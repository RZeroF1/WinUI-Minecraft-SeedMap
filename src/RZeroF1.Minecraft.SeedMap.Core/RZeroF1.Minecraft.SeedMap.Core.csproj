<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>RZeroF1.Minecraft.SeedMap</AssemblyName>
    <RootNamespace>RZeroF1.Minecraft.SeedMap</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>RZeroF1.Minecraft.SeedMap</PackageId>
    <PackageVersion Condition="'$(PackageVersion)' == ''">0.3.0</PackageVersion>
    <Version Condition="'$(Version)' == ''">$(PackageVersion)</Version>
    <Authors>RZeroF1</Authors>
    <Description>面向 Minecraft Java 世界生成计算、种子地图、结构查询、精确基础地形高度与离屏渲染的通用 .NET 10 SDK。</Description>
    <PackageTags>minecraft;java;seed;seedmap;cubiomes;world-generation;biome;structure;terrain;heightmap;map</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/RZeroF1/Minecraft-SeedUniverse</RepositoryUrl>
    <PackageProjectUrl>https://github.com/RZeroF1/Minecraft-SeedUniverse</PackageProjectUrl>
    <PackageReleaseNotes>新增 Minecraft Java 26.1、26.2、26.3 的独立 Native 发行身份、三维度群系及逐阶段结构能力；加入 sulfur_caves、dappled_forest 与原版 26.3 RTree 拓扑。Village/主世界 Ruined Portal 接入 StructureSet 加权重试和 26.3 Portal RNG 修正；26.3 新增 18 类 Abandoned Camp 起点查询。三版默认主世界两种 WorldGen 基础高度使用独立 Terrain Profile，26.3 保留 float 密度与体积插值语义。公开目录扩展为 89 项，保留旧版 Native ID、候选坐标及缓存契约；FullGeneration 保持 Unsupported。</PackageReleaseNotes>
    <PackageOutputPath>$(RepositoryRoot)\artifacts\packages\</PackageOutputPath>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(RepositoryRoot)\README.md" Pack="true" PackagePath="" />
    <None Include="$(RepositoryRoot)\README.en.md" Pack="true" PackagePath="" />
    <None Include="$(RepositoryRoot)\LICENSE" Pack="true" PackagePath="" />
    <None Include="$(RepositoryRoot)\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" />
    <None Include="$(RepositoryRoot)\docs\api.md;$(RepositoryRoot)\docs\architecture.md;$(RepositoryRoot)\docs\nuget.md;$(RepositoryRoot)\docs\versions.md"
          Pack="true" PackagePath="docs" />
    <None Include="$(RepositoryRoot)\licenses\cubiomes\LICENSE" Pack="true" PackagePath="licenses\cubiomes" />
    <None Include="$(RepositoryRoot)\licenses\cubiomes\SOURCE.md" Pack="true" PackagePath="licenses\cubiomes" />
    <None Include="$(RepositoryRoot)\licenses\cubiomes\manifest.json" Pack="true" PackagePath="licenses\cubiomes" />
    <None Include="$(TargetDir)rzero_seedmap.dll"
          Pack="true"
          PackagePath="runtimes\win-x64\native" />
  </ItemGroup>

  <ItemGroup>
    <SeedMapNativeSources Include="$(MSBuildProjectDirectory)\..\..\native\cubiomes\**\*.c;$(MSBuildProjectDirectory)\..\..\native\cubiomes\**\*.h;$(MSBuildProjectDirectory)\..\..\native\cubiomes\build.cmd" />
  </ItemGroup>

  <Target Name="BuildSeedMapNative"
          BeforeTargets="PrepareForBuild"
          Inputs="@(SeedMapNativeSources)"
          Outputs="$(TargetDir)rzero_seedmap.dll"
          Condition="'$(SeedMapNativeRid)' == 'win-x64'">
    <MakeDir Directories="$(TargetDir)" />
    <Exec Command="&quot;$(MSBuildProjectDirectory)\..\..\native\cubiomes\build.cmd&quot; x64 &quot;$(TargetDir)&quot;" />
  </Target>

  <Target Name="RejectUnsupportedSeedMapRid"
          BeforeTargets="Build"
          Condition="'$(SeedMapNativeRid)' != 'win-x64'">
    <Error Text="RZeroF1.Minecraft.SeedMap currently supports only win-x64; received $(SeedMapNativeRid)." />
  </Target>
</Project>
